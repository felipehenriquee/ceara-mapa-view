{
  "name": "ceara-map",
  "version": "0.1.0",
  "description": "Interactive SVG map of the 184 municipalities of Ceará (Brazil) for React, with IBGE mesoregions, IBGE codes and tooltips.",
  "keywords": [
    "ceara",
    "brazil",
    "map",
    "municipalities",
    "ibge",
    "react",
    "svg"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipehenriquee/ceara-mapa.git"
  },
  "homepage": "https://github.com/felipehenriquee/ceara-mapa#readme",
  "bugs": {
    "url": "https://github.com/felipehenriquee/ceara-mapa/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./data": {
      "import": {
        "types": "./dist/data.d.ts",
        "default": "./dist/data.js"
      },
      "require": {
        "types": "./dist/data.d.cts",
        "default": "./dist/data.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19",
    "tsup": "^8",
    "typescript": "^5"
  }
}
